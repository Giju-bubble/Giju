{
  "family": "giju-task",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "1024",
  "memory": "3072",
  "executionRoleArn": "arn:aws:iam::104741737135:role/ecsTaskExecutionRole",
  "taskRoleArn": "arn:aws:iam::104741737135:role/ecsTaskRole",
  "containerDefinitions": [
    {
      "name": "giju-container",
      "image": "104741737135.dkr.ecr.ap-northeast-2.amazonaws.com/giju:latest",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 8080,
          "hostPort": 8080,
          "protocol": "tcp",
          "appProtocol": "http"
        }
      ],

      "secrets": [
        { "name": "CLIENT_SECRET", "valueFrom": "/app/giju/CLIENT_SECRET" },
        { "name": "CLIENT_ID", "valueFrom": "/app/giju/CLIENT_ID" },
        { "name": "JWT_SECRET", "valueFrom": "/app/giju/JWT_SECRET" },
        { "name": "REDIRECT_URI", "valueFrom": "/app/giju/REDIRECT_URI" },
        { "name": "S3STORAGE_ACCESS_KEY", "valueFrom": "/app/giju/S3STORAGE_ACCESS_KEY" },
        { "name": "S3STORAGE_SECRET_KEY", "valueFrom": "/app/giju/S3STORAGE_SECRET_KEY" },
        { "name": "TOSS_SECRET_KEY", "valueFrom": "/app/giju/TOSS_SECRET_KEY" },
        { "name": "DB_URL", "valueFrom": "/app/giju/DB_URL" },
        { "name": "DB_USERNAME", "valueFrom": "/app/giju/DB_USERNAME" },
        { "name": "DB_PASSWORD", "valueFrom": "/app/giju/DB_PASSWORD" }
      ],

      "environment": [
        { "name": "SERVER_PORT", "value": "8080" }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/giju-task",
          "awslogs-create-group": "true",
          "awslogs-region": "ap-northeast-2",
          "awslogs-stream-prefix": "ecs"
        }
      }
    }
  ]
}