{
  "family": "giju-task",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "1024",
  "memory": "3072",
  "executionRoleArn": "arn:aws:iam::104741737135:role/ecsTaskExecutionRole",
  "containerDefinitions": [
    {
      "name": "giju-container",
      "image": "104741737135.dkr.ecr.ap-northeast-2.amazonaws.com/giju:latest",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 8080,
          "hostPort": 8080,
          "protocol": "tcp",
          "appProtocol": "http"
        }
      ],
      "environment": [
        { "name": "CLIENT_SECRET", "value": "$CLIENT_SECRET" },
        { "name": "CLIENT_ID", "value": "$CLIENT_ID" },
        { "name": "JWT_SECRET", "value": "$JWT_SECRET" },
        { "name": "REDIRECT_URI", "value": "$REDIRECT_URI" },
        { "name": "S3STORAGE_ACCESS_KEY", "value": "$S3STORAGE_ACCESS_KEY" },
        { "name": "S3STORAGE_SECRET_KEY", "value": "$S3STORAGE_SECRET_KEY" },
        { "name": "TOSS_SECRET_KEY", "value": "$TOSS_SECRET_KEY" }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/giju-task",
          "awslogs-create-group": "true",
          "awslogs-region": "ap-northeast-2",
          "awslogs-stream-prefix": "ecs"
        }
      }
    }
  ]
}
